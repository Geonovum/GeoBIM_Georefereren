<?xml version="1.0" encoding="UTF-8"?>
<gml:FeatureCollection
    xmlns:gml="http://www.opengis.net/gml/3.2"
    xmlns:ex="http://example.com"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://example.com http://example.com/schema.xsd">

  <gml:featureMember>
    <ex:SampleFeature gml:id="point1">
      <ex:location>
        <gml:Point srsName="urn:ogc:def:crs:EPSG::28992">
          <gml:pos>155000 463000 3.5</gml:pos>
        </gml:Point>
      </ex:location>
    </ex:SampleFeature>
  </gml:featureMember>

  <gml:featureMember>
    <ex:SampleFeature gml:id="point2">
      <ex:location>
        <gml:Point srsName="urn:ogc:def:crs:EPSG::28992">
          <gml:pos>155010 463000 7.2</gml:pos>
        </gml:Point>
      </ex:location>
    </ex:SampleFeature>
  </gml:featureMember>

  <gml:featureMember>
    <ex:SampleFeature gml:id="point3">
      <ex:location>
        <gml:Point srsName="urn:ogc:def:crs:EPSG::28992">
          <gml:pos>155010 463020 12.8</gml:pos>
        </gml:Point>
      </ex:location>
    </ex:SampleFeature>
  </gml:featureMember>

</gml:FeatureCollection>
